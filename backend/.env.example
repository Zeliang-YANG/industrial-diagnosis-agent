# MySQL 连接。run_local.py 会在该实例创建隔离的 industrial_agent_demo 数据库。
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_local_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=industrial_agent_demo

# DeepSeek。Key 只保存在本机，不要提交到 Git。
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_USE_SYSTEM_PROXY=false
DEEPSEEK_MAX_RETRIES=2

# 可选的本地 API 防护和运行配置。
AGENT_API_TOKEN=
AGENT_MAX_CONCURRENCY=4
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
